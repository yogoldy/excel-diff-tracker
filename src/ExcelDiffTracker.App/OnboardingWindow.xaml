<Window x:Class="ExcelDiffTracker.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Excel Scenario Analysis Tool" Width="760" Height="570" MinWidth="660" MinHeight="490" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Icon="app-icon.ico" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="OnboardingWindow" AutomationProperties.Name="Welcome to Excel Scenario Analysis Tool">
    <Grid Margin="28" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" Background="{DynamicResource AccentBrush}" CornerRadius="11"><Canvas Width="38" Height="38"><Path Stroke="{DynamicResource PrimaryForegroundBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M5,7 L17,7 L17,31 L5,31 Z M5,15 L17,15 M5,23 L17,23 M11,7 L11,31 M14,19 L20,19 M20,19 L28,11 M20,19 L31,19 M20,19 L28,27"/><Ellipse Canvas.Left="26" Canvas.Top="9" Width="5" Height="5" Fill="{DynamicResource PrimaryForegroundBrush}"/><Ellipse Canvas.Left="29" Canvas.Top="16.5" Width="5" Height="5" Fill="{DynamicResource PrimaryForegroundBrush}"/><Ellipse Canvas.Left="26" Canvas.Top="24.5" Width="5" Height="5" Fill="{DynamicResource PrimaryForegroundBrush}"/></Canvas></Border>
                <StackPanel Margin="12,0,0,0" MaxWidth="380"><TextBlock FontWeight="Bold" FontSize="18" Text="Excel Scenario Analysis Tool"/><TextBlock Style="{StaticResource MutedText}" Text="Private save evidence and flexible comparisons." TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource MutedText}" Text="{Binding StepLabel}" AutomationProperties.AutomationId="OnboardingStepLabel"/>
        </Grid>

        <ScrollViewer x:Name="StepContentScrollViewer" Grid.Row="1" Margin="0,20,0,18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="OnboardingStepContent">
          <Grid>
            <Grid x:Name="StepOne" AutomationProperties.AutomationId="OnboardingPrivacyStep">
                <StackPanel MaxWidth="540" Margin="8,14" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="72" Height="72" HorizontalAlignment="Center" Background="{DynamicResource AccentSoftBrush}" CornerRadius="36"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontSize="29" Text="⌂"/></Border>
                    <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" FontSize="25" FontWeight="SemiBold" Text="Everything stays on this PC" AutomationProperties.AutomationId="OnboardingPrivacyHeading"/>
                    <TextBlock Margin="0,13,0,0" TextAlignment="Center" Style="{StaticResource MutedText}" FontSize="14" Text="Workbooks are read from a temporary local copy. History is stored in a local SQLite database and Markdown files. Nothing is uploaded, and macros are never executed."/>
                </StackPanel>
            </Grid>

            <Grid x:Name="StepTwo" Visibility="Collapsed" AutomationProperties.AutomationId="OnboardingReportFolderStep">
                <StackPanel MaxWidth="570" Margin="8,14" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" FontSize="25" FontWeight="SemiBold" Text="Choose a report folder" AutomationProperties.AutomationId="OnboardingReportFolderHeading"/>
                    <TextBlock Margin="0,10,0,18" TextAlignment="Center" Style="{StaticResource MutedText}" Text="A readable Markdown report is written here after every distinct post-baseline save."/>
                    <Border x:Name="ReportFolderCard" Style="{StaticResource Card}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" Text="{Binding ReportFolder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReportFolder}" AutomationProperties.AutomationId="SelectedReportFolder"/><Button Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource SecondaryButton}" Click="ChooseReportFolder" Content="Choose…" AutomationProperties.AutomationId="ChooseReportFolderButton" AutomationProperties.Name="Choose report folder"/></Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid x:Name="StepThree" Visibility="Collapsed" AutomationProperties.AutomationId="OnboardingWorkbookStep">
                <StackPanel MaxWidth="570" Margin="8,14" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" FontSize="25" FontWeight="SemiBold" Text="Add your first workbook" AutomationProperties.AutomationId="OnboardingWorkbookHeading"/>
                    <TextBlock Margin="0,10,0,18" TextAlignment="Center" Style="{StaticResource MutedText}" Text="Choosing a workbook creates a silent baseline. Reports begin only after its next distinct save."/>
                    <Border x:Name="WorkbookCard" Style="{StaticResource Card}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock FontWeight="SemiBold" Text="{Binding WorkbookName}"/><TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}" Text="{Binding WorkbookPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkbookPath}"/></StackPanel><Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Click="ChooseWorkbook" Content="Choose workbook…" AutomationProperties.AutomationId="ChooseWorkbookButton" AutomationProperties.Name="Choose workbook"/></Grid>
                    </Border>
                    <TextBlock x:Name="StepThreeStatus" Margin="0,12,0,0" TextAlignment="Center" Foreground="{DynamicResource WarningBrush}" AutomationProperties.AutomationId="WorkbookSelectionStatus" AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </Grid>

            <Grid x:Name="StepFour" Visibility="Collapsed" AutomationProperties.AutomationId="OnboardingOptionsStep">
                <StackPanel MaxWidth="570" Margin="8,14" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" FontSize="25" FontWeight="SemiBold" Text="Keep tracking effortless" AutomationProperties.AutomationId="OnboardingOptionsHeading"/>
                    <TextBlock Margin="0,10,0,18" TextAlignment="Center" Style="{StaticResource MutedText}" Text="These defaults can be changed later in Settings."/>
                    <Border x:Name="OptionsCard" Style="{StaticResource Card}" Padding="0">
                        <StackPanel>
                            <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock FontWeight="SemiBold" Text="Start with Windows"/><TextBlock Style="{StaticResource MutedText}" Text="Runs quietly in the notification area."/></StackPanel><CheckBox x:Name="StartupCheck" Grid.Column="1" VerticalAlignment="Center" IsChecked="True" AutomationProperties.AutomationId="OnboardingStartWithWindowsCheckBox" AutomationProperties.Name="Start Excel Scenario Analysis Tool with Windows"/></Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}"/>
                            <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock FontWeight="SemiBold" Text="Begin tracking now"/><TextBlock Style="{StaticResource MutedText}" Text="Your chosen workbook will receive a silent baseline."/></StackPanel><CheckBox x:Name="TrackingCheck" Grid.Column="1" VerticalAlignment="Center" IsChecked="True" IsEnabled="False" AutomationProperties.AutomationId="OnboardingBeginTrackingCheckBox" AutomationProperties.Name="Begin tracking the selected workbook"/></Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SetupStatus" Margin="0,14,0,0" TextAlignment="Center" Foreground="{DynamicResource WarningBrush}" AutomationProperties.AutomationId="SetupStatus" AutomationProperties.LiveSetting="Assertive"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="StepFive" Visibility="Collapsed" AutomationProperties.AutomationId="OnboardingCompleteStep">
                <StackPanel MaxWidth="540" Margin="8,14" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="72" Height="72" HorizontalAlignment="Center" Background="{DynamicResource AccentSoftBrush}" CornerRadius="36"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontSize="32" FontWeight="Bold" Text="✓"/></Border>
                    <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center" FontSize="25" FontWeight="SemiBold" Text="Tracking is active" AutomationProperties.AutomationId="OnboardingCompleteHeading"/>
                    <TextBlock Margin="0,13,0,0" TextAlignment="Center" Style="{StaticResource MutedText}" Text="You can close the main window whenever you like. Excel Scenario Analysis Tool keeps watching quietly from the notification area and will tell you when a save is captured."/>
                </StackPanel>
            </Grid>
          </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <ProgressBar x:Name="StepProgress" Height="4" VerticalAlignment="Top" Maximum="5" Value="{Binding StepNumber, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" AutomationProperties.AutomationId="OnboardingProgress" AutomationProperties.Name="Setup progress"/>
            <DockPanel Margin="0,22,0,0">
                <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Click="Back" Content="Back" Visibility="Hidden" AutomationProperties.AutomationId="OnboardingBackButton" AutomationProperties.Name="Back"/>
                <Button x:Name="NextButton" DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="110" Style="{StaticResource PrimaryButton}" Click="Next" Content="Continue" IsDefault="True" AutomationProperties.AutomationId="OnboardingNextButton" AutomationProperties.Name="Continue setup"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
